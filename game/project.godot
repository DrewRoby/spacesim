; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but this scaffold was generated for headless/CI use.

config_version=5

[application]

config/name="Spacesim"
config/description="A market simulation game driven by orbital mechanics and behavioral economics."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SimClient="*res://scripts/SimClient.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.07, 0.07, 0.10, 1)
